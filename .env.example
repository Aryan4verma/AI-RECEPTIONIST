# AI Receptionist backend — template only. Copy to .env and fill values.
# NEVER commit real values. Secret classes per docs/backend/ENVIRONMENT.md.

# --- public ---
PORT=8787
SUPABASE_URL=https://ogxdszjypswutekqgorb.supabase.co
SUPABASE_PUBLISHABLE_KEY=
OLLAMA_BASE_URL=http://localhost:11434
WHISPER_SIDECAR_PORT=8788
WHISPER_MODEL=tiny-int8
CALENDAR_MODE=mock
LOG_LEVEL=info
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=60

# --- server-only secrets ---
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_CA_CERT_PATH=
# Path to the CA certificate downloaded from the Supabase dashboard
# (Database settings). TLS verification is mandatory and cannot be disabled.
TOKEN_HASH_SECRET=
# Unused unless a fallback secret store is separately approved (ADR-0002 v0.2).
# Safe to leave blank — blank optional secrets are ignored at startup:
# SECRET_MASTER_KEY=

# --- Stage 7: Google Calendar (owner setup; mode stays mock until verified) ---
# 1. Google Cloud Console → APIs & Services → enable "Google Calendar API".
# 2. Create an OAuth client ID (type: Web application) with the authorized
#    redirect URI exactly:
#      http://localhost:8787/api/v1/admin/integrations/google/callback
# 3. Create (or pick) a DEDICATED test calendar (not your primary) and grant
#    the connecting Google account owner/writer access to it.
# 4. Fill the four values below, restart the backend, then use
#    Admin console → Overview → Google Calendar → "Connect Google account".
#    The refresh token is stored ONLY in the verified Vault secret store.
#    Tokens never reach the browser, logs, or this repository.
# 5. Leave CALENDAR_MODE=mock until the connection is verified. Switching to
#    google requires all four values AND stays inert until the OAuth
#    connection is completed in the admin console. Real event writes are
#    additionally gated by the owner's explicit Q3 test-write authorization.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8787/api/v1/admin/integrations/google/callback
# GOOGLE_CALENDAR_ID=<dedicated-test-calendar-id>@group.calendar.google.com

# --- future frontend phase ---
# CORS_ORIGIN=
